bbcode_enabled = true
text = "[center][b]INFORMACIÓN DE LA PLANTA[/b][/center]

[color=yellow][b]🎮 OBJETIVO DEL NIVEL:[/b][/color]
Una vez superes los [b]100 puntos[/b], dirígete hacia las escaleras o ascensor para pasar al [color=yellow]\"Siguiente Nivel\"[/color].

[color=orange][b]LIBRERÍAS / MANUALES:[/b][/color]
Son lugares donde puedes consultar los procesos paso a paso para solucionar un problema específico de las máquinas.
[i]Acércate a una librería y presiona la tecla [b][E][/b] para consultar la documentación técnica.[/i]"

[node name="Instruction2" type="RichTextLabel" parent="Manual/PageContainer/Information" unique_id=469650589]
layout_mode = 0
offset_left = 611.99994
offset_top = 112.00001
offset_right = 956.3958
offset_bottom = 630.811
rotation = 0.002947845
theme_override_colors/font_outline_color = Color(0.5667738, 0.45260406, 0.24188927, 1)
theme_override_constants/outline_size = 11
